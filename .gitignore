# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# playwright artifacts
/playwright-report/
/test-results/
/screenshots/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ad-hoc local logs and dev-server artifacts
*.log
*.err
dev-server.pid
gitstatus.txt

# local env files
.env*.local

# local tooling config (per-user launch configs)
/.claude/launch.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# transient logs (dev, build, preview, lint, e2e, playwright, smoke, test, prod)
*.log
!scripts/**/*.log

# transient dev server artifacts
dev-server.pid

# screenshots (Playwright captures)
screenshots/

# Windows-only helper scripts (per-user launch helpers, not part of the app)
/scripts/*.ps1
/scripts/*.bat

# one-off debug scripts used to investigate past bugs. Keep `test-doctor-doom.mjs`
# and `smoke-doctor-doom.mjs` (and other intentional scripts) tracked by
# listing them explicitly below.
/scripts/amethyst-shards.svg
/scripts/apply-doom-v2.mjs
/scripts/build.bat
/scripts/debug-*.mjs
/scripts/dump-*.mjs
/scripts/find-*.mjs
/scripts/fix-*.mjs
/scripts/fix-*.ps1
/scripts/generate-amethyst-shards.mjs
/scripts/launch-dev.mjs
/scripts/preview-*.mjs
/scripts/remove-shards.mjs
/scripts/replace-*.mjs
/scripts/replace-*.ps1
/scripts/run-dev-detached.ps1
/scripts/serve.mjs
/scripts/start-and-preview.mjs
/scripts/start-dev.bat
/scripts/start-prod.bat
/scripts/tag-count.mjs
/scripts/test-language-switch*.mjs
